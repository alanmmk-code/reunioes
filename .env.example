# Copie este arquivo para .env e preencha.

# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado para analisar a reunião e escrever a ata
CLAUDE_MODEL=claude-opus-5-5

# Fuso horário da sua agenda
TIMEZONE=America/Sao_Paulo

# Modo automático (python reunioes.py auto): enviar a ata por e-mail
# aos participantes sem perguntar? (sim/nao)
AUTO_ENVIAR_EMAIL=nao

# Porta do painel web
PORTA=5055
