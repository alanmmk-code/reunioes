# Copie este arquivo para .env e preencha.

# Como falar com o Claude:
#   claude_code = usa o Claude Code logado com a sua assinatura (Pro/Max), sem créditos de API (padrão)
#   api         = usa a chave abaixo e cobra créditos por uso
#   auto        = tenta a API e cai para o Claude Code se faltar crédito
IA_MODO=claude_code
# Modelo no Claude Code (vazio = o padrão do seu plano; ex.: opus, sonnet)
CLAUDE_CODE_MODELO=

# Chave da API da Anthropic, só para IA_MODO=api/auto (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado para analisar a reunião e escrever a ata
CLAUDE_MODEL=claude-opus-5-5

# Fuso horário da sua agenda
TIMEZONE=America/Sao_Paulo

# Modo automático (python reunioes.py auto): enviar a ata por e-mail
# aos participantes sem perguntar? (sim/nao)
AUTO_ENVIAR_EMAIL=nao

# Porta do painel web
PORTA=5055

# Gravação local (contas sem transcrição do Meet)
# Seu nome, usado para marcar suas falas na transcrição
SEU_NOME=Eu
# Modelo do Whisper: tiny, base, small (padrão), medium, large-v3-turbo
# Maiores = mais precisos e mais lentos
WHISPER_MODELO=small
# Gravar sozinho quando uma chamada do Meet for detectada no navegador (sim/nao)
GRAVACAO_AUTOMATICA=sim
# Gravações automáticas mais curtas que isso (segundos) são descartadas
DURACAO_MINIMA_SEG=60
# Assistente ao vivo: transcreve durante a reunião e sugere o que responder (sim/nao)
ASSISTENTE_AO_VIVO=sim
# Modelo do Whisper usado ao vivo (precisa ser rápido): tiny, base (padrão), small
WHISPER_MODELO_AO_VIVO=base
